  { "id": "ev-1935-akutagawa-naoki-prize-founded", "year": 1935, "title": "芥川賞・直木賞の創設", "description": "菊池寛が、亡くなった友人の芥川龍之介と直木三十五の名を残すため、二つの文学賞をつくった。芥川賞は主に純文学、直木賞は主に大衆文学の作品に贈られる。", "person_ids": ["kikuchi-kan", "akutagawa-ryunosuke"], "work_ids": [], "term_ids": ["term-junbungaku", "term-taishu-bungaku"], "tags": ["文学賞"], "verification": { "status": "draft", "sources": [], "checked_at": null, "note": "" } },
  { "id": "ev-1935-first-akutagawa-prize", "year": 1935, "title": "第1回芥川賞と太宰治", "description": "第1回芥川賞は石川達三の『蒼氓』が受賞した。候補になった太宰治の『逆行』は受賞を逃し、選考委員の川端康成の選評に反発した太宰は「川端康成へ」という文章を発表した。", "person_ids": ["dazai-osamu", "kawabata-yasunari"], "work_ids": ["gyakko"], "term_ids": [], "tags": ["文学賞", "エピソード"], "verification": { "status": "draft", "sources": [], "checked_at": null, "note": "" } },
